    if typeof(dest) ~= "Vector3" then return end

    snd(9120705982, 1.5)
    c:PivotTo(CFrame.new(dest + Vector3.new(0, 3, 0)))
end

-- SISTEMA DE FACAS

-- A ponta local da faca fica alinhada com a normal da superfície.
-- A lâmina aponta para dentro da superfície, independentemente
-- de a faca ser colocada numa parede, no chão ou no teto.

local function getKnifeCFrame(position, normal, tipOffset)
    if typeof(normal) ~= "Vector3" or normal.Magnitude < 0.001 then
        normal = Vector3.yAxis
    else
        normal = normal.Unit
    end

    -- O eixo Y local aponta da base da faca para a ponta.
    -- A ponta deve apontar contra a normal, entrando na superfície.
    local bladeAxis = -normal

    -- Escolhe um eixo de referência que não seja paralelo
    -- à direção da lâmina, evitando uma base degenerada.
    local reference = Vector3.yAxis

    if math.abs(reference:Dot(bladeAxis)) > 0.95 then
        reference = Vector3.xAxis
    end

    local right = reference:Cross(bladeAxis)

    if right.Magnitude < 0.001 then
        reference = Vector3.zAxis
        right = reference:Cross(bladeAxis)
    end

    right = right.Unit

    local back = right:Cross(bladeAxis).Unit

    local rotation = CFrame.fromMatrix(
        Vector3.zero,
        right,
        bladeAxis,
        back
    )

    -- Usa a posição real da ponta, não o centro da faca.
    local localTip = tipOffset or Vector3.new(0, 1.32, 0)
    local worldTipOffset = rotation:VectorToWorldSpace(localTip)

    -- Pequena penetração para a ponta não ficar visualmente
    -- separada da parede ou da superfície.
    local embeddedTipPosition = position - normal * 0.025

    return CFrame.new(
        embeddedTipPosition - worldTipOffset
    ) * rotation
end

local function isCharacterPart(part)
    if not part then return false end

    for _, player in ipairs(P:GetPlayers()) do
        local character = player.Character

        if character and part:IsDescendantOf(character) then
            return true
        end
    end

    return false
end

local function removeKnifeWeld(record)
    if record and record.Weld then
        record.Weld:Destroy()
        record.Weld = nil
    end
end

local function attachKnifeToSupport(record, support)
    if not record or not record.Knife or not record.Knife.Parent then
        return
    end

    local knife = record.Knife

    if not support or not support:IsA("BasePart") then
        record.Support = nil
        return
    end

    if support == knife or support:IsDescendantOf(knife) then
        return
    end

    if isCharacterPart(support) and record.Kind ~= "player" then
        return
    end

    removeKnifeWeld(record)

    record.Support = support
    record.SurfacePart = support
    record.RelativeCFrame = support.CFrame:ToObjectSpace(knife.CFrame)

    knife.Anchored = false
    knife.CanCollide = false
    knife.CanTouch = true

    local weld = Instance.new("WeldConstraint")
    weld.Name = "TP_KnifeWeld"
    weld.Part0 = knife
    weld.Part1 = support
    weld.Parent = knife

    record.Weld = weld
end

local function applyKnifeMode(record)
    if not record or not record.Knife or not record.Knife.Parent then
        return
    end

    local knife = record.Knife
    removeKnifeWeld(record)

    if bk.anchored_knifes then
        knife.Anchored = true
        knife.CanCollide = false
        knife.CanTouch = false
    else
        knife.CanTouch = true

        if record.Support and record.Support.Parent then
            attachKnifeToSupport(record, record.Support)
        else
            knife.Anchored = false
            knife.CanCollide = true
        end
    end
end

local function destroyKnife(knife)
    if not knife then return end

    local record = knifeRecords[knife]

    if record then
        removeKnifeWeld(record)

        if record.TouchConnection then
            record.TouchConnection:Disconnect()
        end

        knifeRecords[knife] = nil
    end

    pcall(function()
        knife:Destroy()
    end)
end

local function createAnchoredKnife(position, normal, name, supportPart, kind, targetPart)
    if typeof(position) ~= "Vector3" then return nil end

    kind = kind or "map"

    local knife = Instance.new("Part")

    -- A malha clássica inteira é identificada como Blade.
    -- Não é possível separar a geometria interna do SpecialMesh.
    knife.Name = kind == "map" and "Blade" or (name or "Blade")
    knife.Size = Vector3.new(0.3, 2.2, 0.6)
    knife.Anchored = true
    knife.CanCollide = false
    knife.CanTouch = true
    knife.CanQuery = false
    knife.Transparency = 0
    knife.Massless = false

    knife:SetAttribute("TP_InstanceId", TP_INSTANCE_ID)
    knife:SetAttribute("TP_InstancePassword", TP_INSTANCE_PASSWORD)
    knife:SetAttribute("TP_KnifePart", "Blade")
    knife:SetAttribute("TP_KnifeKind", kind)

    if typeof(normal) == "Vector3" and normal.Magnitude > 0 then
        knife:SetAttribute("TP_SurfaceNormal", normal.Unit)
    end

    if supportPart and supportPart:IsA("BasePart") then
        knife:SetAttribute("TP_SurfaceName", supportPart.Name)
    end

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = "rbxassetid://121944778"
    mesh.TextureId = "rbxassetid://121944805"
    mesh.Scale = Vector3.new(1.2, 1.2, 1.2)
    mesh.Parent = knife

    local tip = Instance.new("Attachment")
    tip.Name = "BladeTip"

    -- A ponta visual da malha considera a escala 1.2.
    tip.Position = Vector3.new(
        0,
        (knife.Size.Y / 2) * mesh.Scale.Y,
        0
    )

    tip.Parent = knife

    knife.CFrame = getKnifeCFrame(position, normal, tip.Position)
    knife.Parent = W

    local record = {
        Knife = knife,
        BladePart = knife,
        Tip = tip,
        Support = supportPart,
        SurfacePart = supportPart,
        SurfaceNormal = normal or Vector3.yAxis,
        Kind = kind,
        TargetPart = targetPart,
        Weld = nil,
        RelativeCFrame = nil,
        TouchConnection = nil
    }

    if supportPart and supportPart:IsA("BasePart") then
        record.RelativeCFrame = supportPart.CFrame:ToObjectSpace(knife.CFrame)
    end

    knifeRecords[knife] = record

    record.TouchConnection = knife.Touched:Connect(function(hit)
        if guiClosed or bk.anchored_knifes then return end
        if not knife.Parent or record.Weld then return end
        if not hit or not hit:IsA("BasePart") then return end
        if hit == knife or hit:IsDescendantOf(knife) then return end
        if record.Kind == "player" then return end
        if isCharacterPart(hit) then return end

        attachKnifeToSupport(record, hit)
    end)

    applyKnifeMode(record)
    return knife
end

local function setAllKnivesAnchoring()
    for knife, record in pairs(knifeRecords) do
        if knife and knife.Parent then
            applyKnifeMode(record)
        else
            knifeRecords[knife] = nil
        end
    end
end

local function getClickedSurface()
    local target = m.Target
    local hit = m.Hit

    if not target or not hit then
        return nil, nil, nil
    end

    local hitPos = hit.Position

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {pl.Character}
    params.IgnoreWater = true

    local origin = cam and cam.CFrame.Position
        or hitPos + Vector3.new(0, 8, 0)

    local direction = hitPos - origin

    if direction.Magnitude > 0.001 then
        local result = W:Raycast(
            origin,
            direction.Unit * (direction.Magnitude + 3),
            params
        )

        if result and result.Instance == target then
            return result.Position, result.Normal, result.Instance
        end
    end

    if target:IsA("BasePart") then
        local localNormal = Vector3.FromNormalId(m.TargetSurface)
        local worldNormal = target.CFrame:VectorToWorldSpace(localNormal)

        if worldNormal.Magnitude > 0.001 then
            return hitPos, worldNormal.Unit, target
        end
    end

    return hitPos, Vector3.yAxis, target
end

local function getPlayerSurface()
    c = pl.Character

    local root = c and c:FindFirstChild(HRP)
    if not root then return nil, nil, nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {c}
    params.IgnoreWater = true

    local origin = root.Position + Vector3.new(0, 2, 0)
    local result = W:Raycast(origin, Vector3.new(0, -20, 0), params)

    if result then
        return result.Position, result.Normal, result.Instance
    end

    return nil, nil, nil
end

