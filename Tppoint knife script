deleteMapPoint = function(item)
    if guiClosed or not item then return end

    local index = table.find(bk.mapPoints, item)
    if not index then return end

    if item.Ancor then
        item.Ancor:Destroy()
        item.Ancor = nil
    end

    if item.Knife then
        destroyKnife(item.Knife)
        item.Knife = nil
    end

    table.remove(bk.mapPoints, index)

    for i, point in ipairs(bk.mapPoints) do
        point.Idx = i

        if point.Knife and point.Knife.Parent then
            point.Knife.Name = "Blade"
            point.Knife:SetAttribute("TP_MapPointIndex", i)
        end
    end

    bk.cnt = #bk.mapPoints

    if specActive then
        if #bk.mapPoints == 0 then
            endSpectate()
        else
            if specIndex > index then
                specIndex -= 1
            elseif specIndex == index then
                specIndex = math.min(index, #bk.mapPoints)
            end
            updateSpecCamera()
        end
    end

    rebuildLists()
end

local function addListButton(pos, isPl, targetPlayer, index, surfaceNormal, surfacePart)
    if guiClosed or not pos then return end

    local name = isPl and targetPlayer.Name or ("tppoint " .. tostring(index))
    local anchor, labelButton = makeLabel3D(pos, name, isPl)

    local knife

    if not isPl then
        knife = createAnchoredKnife(
            pos,
            surfaceNormal or Vector3.yAxis,
            "Blade",
            surfacePart,
            "map"
        )

        if knife then
            knife:SetAttribute("TP_MapPointIndex", index)
        end
    end

    snd(137951817204948, 1)

    connect(labelButton.MouseButton1Click, function()
        if guiClosed then return end
        local now = tick()

        if now - t2 <= W_T and t2 ~= 0 then
            tp(pos, isPl, targetPlayer)
            t2 = 0
        else
            t2 = now
        end
    end)

    if isPl then
        table.insert(bk.playerPoints, {
            Pos = pos,
            PlName = targetPlayer.Name,
            PlayerObj = targetPlayer,
            Ancor = anchor,
            Knife = knife
        })
    else
        table.insert(bk.mapPoints, {
            Pos = pos,
            Idx = index,
            Ancor = anchor,
            Knife = knife,
            SurfaceNormal = surfaceNormal or Vector3.yAxis,
            SurfacePart = surfacePart
        })
    end

    rebuildLists()
end

local function removePlayerPointByPlayer(targetPlayer)
    if not targetPlayer then return end

    for i = #bk.playerPoints, 1, -1 do
        local item = bk.playerPoints[i]

        if item.PlayerObj == targetPlayer or item.PlName == targetPlayer.Name then
            if item.Ancor then item.Ancor:Destroy() end
            if item.Knife then destroyKnife(item.Knife) end
