local function createSafePoint(pos, normal, supportPart)
    if guiClosed or typeof(pos) ~= "Vector3" then return end

    if safe_data then
        if safe_data.Knife then destroyKnife(safe_data.Knife) end
        if safe_data.Ancor then safe_data.Ancor:Destroy() end
        safe_data = nil
    end

    bk.safe_pos = pos
    bk.sf_act = true
    bk.safe_capture = false

    local safeKnife = createAnchoredKnife(
        pos,
        normal or Vector3.yAxis,
        "TP_SafePointKnife_" .. TP_INSTANCE_ID,
        supportPart,
        "safe"
    )

    local anchor, label = makeLabel3D(pos, "SAFE_POINT", false)
    label.TextColor3 = THEME.green

    safe_data = {
        Knife = safeKnife,
        Cube = safeKnife,
        Ancor = anchor,
        TargetPos = pos,
        SurfaceNormal = normal or Vector3.yAxis,
        SurfacePart = supportPart
    }

    updateSafeDeleteVisibility()
    snd(1841353894, 1)

    connect(label.MouseButton1Click, function()
        if guiClosed then return end

        local now = tick()

        if now - t2 <= W_T and t2 ~= 0 then
            local targetPos = safe_data and safe_data.TargetPos

            if targetPos then
                tp(targetPos, false, nil)
            end

            t2 = 0
        else
            t2 = now
        end
    end)
end

local function deleteSafePoint()
    if guiClosed then return end

    if safe_data then
        if safe_data.Knife then
            destroyKnife(safe_data.Knife)
