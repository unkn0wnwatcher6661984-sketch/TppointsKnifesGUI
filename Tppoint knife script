-- CAPTURA DOS PONTOS DO MAPA
-- São necessários três cliques consecutivos na mesma região.

connect(m.Button1Down, function()
    if guiClosed then return end
    if not bk.ok or bk.curPage ~= 1 then return end

    local now = tick()

    if now - t3 < CD then return end

    local hitPos, normal, surfacePart = getClickedSurface()
    if not hitPos then return end

    if captureCount == 0 or now - t1 > W_T then
        captureCount = 1
        captureFirstPos = hitPos
        t1 = now
        return
    end

    if captureFirstPos and (hitPos - captureFirstPos).Magnitude > 10 then
        captureCount = 1
        captureFirstPos = hitPos
        t1 = now
        return
    end

    captureCount += 1
    if captureCount < 3 then return end

    captureCount = 0
    captureFirstPos = nil
    t1 = 0
    t3 = now

    bk.cnt = #bk.mapPoints + 1

    addListButton(
        hitPos,
        false,
        nil,
        bk.cnt,
        normal,
        surfacePart
    )
end)

connect(R.Heartbeat, function()
    if guiClosed then return end

    c = pl.Character

    local root = c and c:FindFirstChild(HRP)
    local hum = c and c:FindFirstChildOfClass("Humanoid")

    if not root or not hum then return end

    -- TELEPORTE AUTOMÁTICO PELO HP

    if safe_data and safe_data.TargetPos and hum.Health > 0 and hum.MaxHealth > 0 then
        local now = tick()

        if hum.Health / hum.MaxHealth <= bk.safe_hp and now - t_sf >= SF_CD then
            t_sf = now
            tp(safe_data.TargetPos, false, nil)
        end
    end

    -- RADAR DE JOGADORES

    if bk.pl_rad then
        if zone then
            zone.Position = root.Position + Vector3.new(0, -3, 0)
        end

        for _, other in ipairs(P:GetPlayers()) do
            if other ~= pl and other.Character then
                local otherCharacter = other.Character
                local otherRoot = otherCharacter:FindFirstChild(HRP)
                local otherHead = otherCharacter:FindFirstChild("Head")

                if otherRoot and otherHead then
                    local distance = (root.Position - otherRoot.Position).Magnitude

                    if distance <= bk.players_radar_studs then
                        local itemFound = nil

                        for _, item in ipairs(bk.playerPoints) do
                            if item.PlayerObj == other then
                                itemFound = item
                                break
                            end
                        end

                        if not itemFound then
                            snd(1841353894, 1.5)

                            local anchor, label = makeLabel3D(
                                otherHead.Position,
                                other.Name,
                                true
                            )

                            local headTop = otherHead.Position + Vector3.new(0, otherHead.Size.Y / 2, 0)

                            local knife = createAnchoredKnife(
                                headTop,
                                Vector3.new(0, -1, 0),
                                "TP_PlayerKnife_" .. other.Name .. "_" .. TP_INSTANCE_ID,
                                otherHead,
                                "player",
                                otherHead
                            )

                            connect(label.MouseButton1Click, function()
                                if guiClosed then return end

                                local now = tick()

                                if now - t2 <= W_T and t2 ~= 0 then
                                    local target = P:FindFirstChild(other.Name)

                                    if target and target.Character and target.Character:FindFirstChild(HRP) then
                                        tp(target.Character[HRP].Position, true, target)
                                    end

                                    t2 = 0
                                else
                                    t2 = now
                                end
                            end)

                            table.insert(bk.playerPoints, {
                                Pos = otherHead.Position,
                                PlName = other.Name,
                                PlayerObj = other,
                                Ancor = anchor,
                                Knife = knife,
                                TargetPart = otherHead
                            })

                            rebuildLists()
                        end
                    end
                end
            end
        end

        -- ATUALIZAÇÃO DAS MARCAÇÕES DO RADAR

        for _, item in ipairs(bk.playerPoints) do
            local target = item.PlayerObj
            local character = target and target.Character

            local head = character and character:FindFirstChild("Head")
            local targetRoot = character and character:FindFirstChild(HRP)

            if head and targetRoot then
                item.Pos = head.Position

                if item.Ancor and item.Ancor.Parent then
                    item.Ancor.Position = head.Position + Vector3.new(0, 10, 0)
                end

                if item.TargetPart ~= head then
                    if item.Knife then destroyKnife(item.Knife) end

                    item.TargetPart = head

                    local headTop = head.Position + Vector3.new(0, head.Size.Y / 2, 0)

                    item.Knife = createAnchoredKnife(
                        headTop,
                        Vector3.new(0, -1, 0),
                        "TP_PlayerKnife_" .. item.PlName .. "_" .. TP_INSTANCE_ID,
                        head,
                        "player",
                        head
                    )
                end

                local record = item.Knife and knifeRecords[item.Knife]

                if record and bk.anchored_knifes then
                    record.TargetPart = head

                    if head.Parent then
                        if record.RelativeCFrame then
                            item.Knife.CFrame = head.CFrame * record.RelativeCFrame
                        else
                            local headTop = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
                            item.Knife.CFrame = getKnifeCFrame(
                                headTop,
                                Vector3.new(0, -1, 0),
                                record.Tip and record.Tip.Position
                            )
                            record.RelativeCFrame = head.CFrame:ToObjectSpace(item.Knife.CFrame)
                        end
                    end
                end
            end
        end

        -- ATUALIZAÇÃO DAS FACAS ANCORADAS DOS JOGADORES

        if bk.anchored_knifes then
            for knife, record in pairs(knifeRecords) do
                if knife and knife.Parent and record.Kind == "player" then
                    local targetPart = record.TargetPart

                    if targetPart and targetPart.Parent and record.RelativeCFrame then
                        knife.CFrame = targetPart.CFrame * record.RelativeCFrame
                    end
                end
            end
        end

        -- LIMPEZA DE SUPORTES DESTRUÍDOS

        if not bk.anchored_knifes then
            for knife, record in pairs(knifeRecords) do
                if knife and knife.Parent then
                    if record.Support and not record.Support.Parent then
                        removeKnifeWeld(record)
                        record.Support = nil
                        record.SurfacePart = nil
                        knife.Anchored = false
                        knife.CanCollide = true
                        knife.CanTouch = true
                    end
                else
                    knifeRecords[knife] = nil
                end
            end
        end
    end
end)

