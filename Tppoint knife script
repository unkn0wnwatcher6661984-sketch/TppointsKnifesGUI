    local function dragFrame(frame)
        local dragging, dragStartPosition, frameStartUDim, activeTouch = false, nil, nil, nil

        local function isTouchOnJoystick(input)
            local touchGui = pg:FindFirstChild("TouchGui")
            if not touchGui or not input then return false end

            local touchPosition = Vector2.new(input.Position.X, input.Position.Y)

            for _, obj in ipairs(touchGui:GetDescendants()) do
                if obj:IsA("GuiObject") and obj.Visible then
                    local objectName = string.lower(obj.Name)

                    if string.find(objectName, "thumbstick", 1, true) then
                        local left = obj.AbsolutePosition.X
                        local top = obj.AbsolutePosition.Y
                        local right = left + obj.AbsoluteSize.X
                        local bottom = top + obj.AbsoluteSize.Y

                        if touchPosition.X >= left and touchPosition.X <= right
                            and touchPosition.Y >= top and touchPosition.Y <= bottom then
                            return true
                        end
                    end
                end
            end

            return false
        end

        local function applyDrag(pointerPosition)
            if not dragging or guiClosed or not frame.Parent or not frame.Visible then return end

            local delta = pointerPosition - dragStartPosition

            frame.Position = UDim2.new(
                frameStartUDim.X.Scale,
                frameStartUDim.X.Offset + delta.X,
                frameStartUDim.Y.Scale,
                frameStartUDim.Y.Offset + delta.Y
            )
        end

        local function beginDrag(input)
            if guiClosed or dragging or not frame.Visible then return end

            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            if input.UserInputType == Enum.UserInputType.Touch and isTouchOnJoystick(input) then
                return
            end

            dragging = true
            dragStartPosition = Vector2.new(input.Position.X, input.Position.Y)
            frameStartUDim = frame.Position
            activeTouch = input.UserInputType == Enum.UserInputType.Touch and input or nil

            connect(input.Changed, function()
                if input.UserInputState == Enum.UserInputState.End then
                    if activeTouch == input then activeTouch = nil end
                    dragging = false
                end
            end)
        end

        connect(dragHandle.InputBegan, beginDrag)
        connect(mainDragSurface.InputBegan, beginDrag)
        connect(configDragSurface.InputBegan, beginDrag)

        connect(U.InputChanged, function(input)
            if not dragging then return end

